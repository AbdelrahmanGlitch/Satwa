# Copy this file to .env and fill in real values. Never commit .env itself.

PORT=5000
MONGO_URI=

# bcrypt cost factor
SALT_ROUND=

# AES key used to encrypt/decrypt user phone numbers at rest
ENCRYPTION_KEY=

# JWT signing secrets — keep user/admin separate so one token type can
# never be replayed as the other
SIGNATURE_TOKEN_USER=
SIGNATURE_TOKEN_ADMIN=
SIGNATURE_EMAIL=

# Gmail account used to send OTP/confirmation emails (use an app password,
# not the account password)
EMAIL=
PASSWORD=

# Shared code required to hit the admin-creation endpoint
ADMIN_CODE=

# Cloudinary (image uploads)
cloudName=
api_key=
api_secret=

# Google OAuth 2.0 Web Client ID (Google Cloud Console) — see
# src/utils/google/verifyGoogleToken.js
GOOGLE_CLIENT_ID=
